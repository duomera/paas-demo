<?xml version="1.0" encoding="utf-8"?>
<!-- The visitors' user: a normal internal user with Sales, CRM and Inventory rights; no settings, no app installation.
     Login and password are shown publicly on the sign-in page. -->
<odoo noupdate="1">
    <record id="demo_visitor" model="res.users">
        <field name="name">Demo Visitor</field>
        <field name="login">demo</field>
        <field name="password">demo</field>
        <field name="email">demo@example.com</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('sales_team.group_sale_salesman'), ref('stock.group_stock_user')])]"/>
        <field name="signature">Exploring the live demo</field>
    </record>
</odoo>
